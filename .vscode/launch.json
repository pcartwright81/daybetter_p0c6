{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Home Assistant: Debug",
      "type": "debugpy",
      "request": "launch",
      "module": "homeassistant",
      "args": [
        "-c",
        "${workspaceFolder}/config",
        "--debug"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "linux": {
        "python": "/home/vscode/.venv/bin/python"
      },
      "console": "integratedTerminal",
      "justMyCode": true,
      "subProcess": false
    },
    {
      "name": "Pytest: All Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-v"
      ],
      "linux": {
        "python": "/home/vscode/.venv/bin/python"
      },
      "windows": {
        "python": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "console": "integratedTerminal",
      "justMyCode": true,
      "subProcess": false
    },
    {
      "name": "Pytest: Current File",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-v",
        "${file}"
      ],
      "linux": {
        "python": "/home/vscode/.venv/bin/python"
      },
      "windows": {
        "python": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "console": "integratedTerminal",
      "justMyCode": true,
      "subProcess": false
    },
    {
      "name": "Home Assistant: Remote Attach (debugpy)",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "homeassistant.local",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/custom_components",
          "remoteRoot": "/config/custom_components"
        }
      ],
      "justMyCode": true
    }
  ]
}
